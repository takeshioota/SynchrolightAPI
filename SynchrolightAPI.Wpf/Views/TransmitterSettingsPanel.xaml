<UserControl x:Class="SynchrolightAPI.Wpf.Views.TransmitterSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <GroupBox Header="送信機設定">
        <StackPanel Margin="4">
            <TextBlock Text="チャネル:" Margin="0,0,0,2"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <ComboBox ItemsSource="{Binding ChannelOptions}" SelectedItem="{Binding SelectedChannel}" Width="60" Margin="0,0,8,0"/>
                <Button Content="チャネル設定 FA" Command="{Binding SetChannelCommand}" Padding="8,2"/>
            </StackPanel>

            <TextBlock Text="電力:" Margin="0,0,0,2"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <ComboBox ItemsSource="{Binding PowerOptions}" SelectedItem="{Binding SelectedPower}" Width="60" Margin="0,0,8,0"/>
                <Button Content="電力設定 FB" Command="{Binding SetPowerCommand}" Padding="8,2"/>
            </StackPanel>

            <Button Content="初期設定一括送信 (FA+FB)" Command="{Binding InitializeTransmitterCommand}"
                    Padding="8,4" Margin="0,0,0,8" FontWeight="Bold"/>

            <Separator Margin="0,4"/>

            <!-- キープアライブ設定 -->
            <TextBlock Text="キープアライブ:" FontWeight="Bold" Margin="0,4,0,4"/>
            <TextBlock Text="※端末機は10分間無受信で自動消灯します" Foreground="OrangeRed" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <CheckBox Content="有効" IsChecked="{Binding IsKeepAliveEnabled}"
                          Command="{Binding ToggleKeepAliveCommand}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding KeepAliveIntervalOptions}" SelectedItem="{Binding SelectedKeepAliveInterval}"
                          Width="60" Margin="0,0,4,0"/>
                <TextBlock Text="秒" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{Binding KeepAliveStatus}" Foreground="DarkGreen" FontSize="11" Margin="0,0,0,4"/>

            <Separator Margin="0,4"/>

            <!-- ステータス（Phase2/3拡張） -->
            <TextBlock Text="ステータス:" FontWeight="Bold" Margin="0,4,0,4"/>
            <TextBlock>
                <Run Text="キュー: "/><Run Text="{Binding QueueLength, Mode=OneWay}"/>
                <Run Text=" (優先: "/><Run Text="{Binding HighPriorityQueueLength, Mode=OneWay}"/><Run Text=")"/>
            </TextBlock>
            <TextBlock>
                <Run Text="ポート: "/><Run Text="{Binding ConnectedPorts, Mode=OneWay}"/>
            </TextBlock>
            <!-- 切断ポート表示 -->
            <TextBlock Foreground="OrangeRed">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DisconnectedPorts}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <Run Text="切断中: "/><Run Text="{Binding DisconnectedPorts, Mode=OneWay}"/>
            </TextBlock>
            <!-- レイテンシ -->
            <TextBlock FontSize="11" Foreground="DarkSlateGray">
                <Run Text="遅延: "/><Run Text="{Binding LatencyText, Mode=OneWay}"/>
            </TextBlock>
            <!-- エラー -->
            <TextBlock Text="{Binding LastError}" Foreground="Red" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LastError}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </GroupBox>
</UserControl>
