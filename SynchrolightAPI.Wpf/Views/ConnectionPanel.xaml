<UserControl x:Class="SynchrolightAPI.Wpf.Views.ConnectionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SynchrolightAPI.Wpf.Converters">
    <UserControl.Resources>
        <conv:BoolToColorConverter x:Key="BoolToColor"/>
    </UserControl.Resources>
    <GroupBox Header="接続">
        <StackPanel Margin="4">
            <TextBlock Text="COMポート:" FontWeight="Bold" Margin="0,0,0,4"/>

            <ItemsControl ItemsSource="{Binding Ports}" Margin="0,0,0,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,2"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="ポート検索" Command="{Binding ScanPortsCommand}" Margin="0,0,0,4"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Button Content="接続" Command="{Binding ConnectCommand}" Width="70" Margin="0,0,4,0"/>
                <Button Content="切断" Command="{Binding DisconnectCommand}" Width="70"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="状態: "/>
                <Ellipse Width="10" Height="10" Margin="0,2,4,0"
                         Fill="{Binding IsConnected, Converter={StaticResource BoolToColor}}"/>
                <TextBlock Text="{Binding StatusText}"/>
            </StackPanel>

            <Separator Margin="0,8"/>

            <!-- 注意事項 -->
            <TextBlock Text="注意事項" FontWeight="Bold" Foreground="OrangeRed" Margin="0,4,0,2"/>
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray" Margin="0,0,0,2"
                       Text="・初回発送分(200個)は電源ON後5分間BTモードのため2.4G受信不可"/>
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray"
                       Text="・端末機は電源ONでCh4がデフォルト。送信機もCh4に合わせてください"/>
        </StackPanel>
    </GroupBox>
</UserControl>
