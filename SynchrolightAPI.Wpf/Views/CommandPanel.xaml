<UserControl x:Class="SynchrolightAPI.Wpf.Views.CommandPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SynchrolightAPI.Wpf.Converters">
    <UserControl.Resources>
        <conv:ByteToHexConverter x:Key="ByteToHex"/>
        <conv:RgbToBrushConverter x:Key="RgbToBrush"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12">

                <!-- ===== モード切替トグル ===== -->
                <Border Background="{StaticResource AccentLightBrush}" CornerRadius="8" Padding="4" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton Grid.Column="0" GroupName="Mode" Style="{StaticResource ToggleTab}"
                                     IsChecked="{Binding IsEffectMode, Converter={StaticResource InvertBool}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F4E8;" Margin="0,0,6,0"/>
                                <TextBlock Text="&#x30B3;&#x30DE;&#x30F3;&#x30C9;"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="1" GroupName="Mode" Style="{StaticResource ToggleTab}"
                                     IsChecked="{Binding IsEffectMode}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x2728;" Margin="0,0,6,0"/>
                                <TextBlock Text="&#x30A8;&#x30D5;&#x30A7;&#x30AF;&#x30C8;"/>
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                </Border>

                <!-- ===== 共通: Field & 色 ===== -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <!-- Field -->
                        <StackPanel Visibility="{Binding ShowField, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                            <TextBlock Text="&#x1F4CC; FIELD" Style="{StaticResource SectionHeader}"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox ItemsSource="{Binding FieldOptions}" SelectedItem="{Binding SelectedFieldOption}"
                                          DisplayMemberPath="Label" Width="60"/>
                                <TextBlock Text="{Binding FieldDescription}" VerticalAlignment="Center"
                                           Margin="8,0,0,0" Foreground="{StaticResource SubtleBrush}" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- 色 -->
                        <TextBlock Text="&#x1F3A8; COLOR" Style="{StaticResource SectionHeader}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="R" VerticalAlignment="Center" Width="14" FontWeight="Bold" Foreground="#EF4444"/>
                            <TextBox Text="{Binding ColorR, Converter={StaticResource ByteToHex}, UpdateSourceTrigger=PropertyChanged}" Width="42" Margin="0,0,10,0"/>
                            <TextBlock Text="G" VerticalAlignment="Center" Width="14" FontWeight="Bold" Foreground="#22C55E"/>
                            <TextBox Text="{Binding ColorG, Converter={StaticResource ByteToHex}, UpdateSourceTrigger=PropertyChanged}" Width="42" Margin="0,0,10,0"/>
                            <TextBlock Text="B" VerticalAlignment="Center" Width="14" FontWeight="Bold" Foreground="#3B82F6"/>
                            <TextBox Text="{Binding ColorB, Converter={StaticResource ByteToHex}, UpdateSourceTrigger=PropertyChanged}" Width="42"/>
                        </StackPanel>

                        <!-- プレビュー -->
                        <Border Height="28" Margin="0,0,0,8" CornerRadius="6"
                                BorderBrush="#D1D5DB" BorderThickness="1">
                            <Border.Background>
                                <MultiBinding Converter="{StaticResource RgbToBrush}">
                                    <Binding Path="ColorR"/>
                                    <Binding Path="ColorG"/>
                                    <Binding Path="ColorB"/>
                                </MultiBinding>
                            </Border.Background>
                        </Border>

                        <!-- プリセットカラー -->
                        <WrapPanel>
                            <Button Command="{Binding SetPresetColorCommand}" CommandParameter="Red"
                                    Margin="0,0,4,4" Cursor="Hand" Padding="10,6" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="4" Padding="10,6"
                                                Background="#EF4444" BorderThickness="1.5" BorderBrush="#DC2626">
                                            <TextBlock Text="Red" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="White" HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Command="{Binding SetPresetColorCommand}" CommandParameter="Green"
                                    Margin="0,0,4,4" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="4" Padding="10,6"
                                                Background="#22C55E" BorderThickness="1.5" BorderBrush="#16A34A">
                                            <TextBlock Text="Green" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="White" HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Command="{Binding SetPresetColorCommand}" CommandParameter="Blue"
                                    Margin="0,0,4,4" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="4" Padding="10,6"
                                                Background="#3B82F6" BorderThickness="1.5" BorderBrush="#2563EB">
                                            <TextBlock Text="Blue" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="White" HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Command="{Binding SetPresetColorCommand}" CommandParameter="White"
                                    Margin="0,0,4,4" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="4" Padding="10,6"
                                                Background="White" BorderThickness="1.5" BorderBrush="#D1D5DB">
                                            <TextBlock Text="White" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="#374151" HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Command="{Binding SetPresetColorCommand}" CommandParameter="Black"
                                    Margin="0,0,4,4" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="4" Padding="10,6"
                                                Background="#1F2937" BorderThickness="1.5" BorderBrush="#111827">
                                            <TextBlock Text="Black" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="White" HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ===== コマンドモード ===== -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEffectMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="&#x1F4E8; COMMAND" Style="{StaticResource SectionHeader}"/>

                            <!-- コマンドトグルボタン -->
                            <ItemsControl ItemsSource="{Binding CommandItems}" Margin="0,0,0,8">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton GroupName="CmdType"
                                                     IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                     Margin="0,0,4,4" Cursor="Hand">
                                            <RadioButton.Template>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border x:Name="Bd" CornerRadius="4" Padding="12,8"
                                                            BorderThickness="1.5" BorderBrush="#E5E7EB"
                                                            Background="White">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock x:Name="Icon" Text="{Binding Icon}"
                                                                       FontSize="15" VerticalAlignment="Center"
                                                                       Margin="0,0,6,0"/>
                                                            <TextBlock x:Name="Code" Text="{Binding Code}"
                                                                       FontSize="14" FontWeight="Bold"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="#374151"
                                                                       Margin="0,0,5,0"/>
                                                            <TextBlock x:Name="Label" Text="{Binding Label}"
                                                                       FontSize="13"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="#9CA3AF"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#4ADE80"/>
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#22C55E"/>
                                                            <Setter TargetName="Code" Property="Foreground" Value="White"/>
                                                            <Setter TargetName="Label" Property="Foreground" Value="#F0FFF4"/>
                                                        </Trigger>
                                                        <MultiTrigger>
                                                            <MultiTrigger.Conditions>
                                                                <Condition Property="IsChecked" Value="False"/>
                                                                <Condition Property="IsMouseOver" Value="True"/>
                                                            </MultiTrigger.Conditions>
                                                            <Setter TargetName="Bd" Property="Background" Value="#F0FDF4"/>
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#86EFAC"/>
                                                        </MultiTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </RadioButton.Template>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- パラメータ群 -->
                            <StackPanel Visibility="{Binding ShowStartRow, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                                <TextBlock Text="&#x2195; &#x958B;&#x59CB;&#x884C;:" FontSize="11" Foreground="{StaticResource SubtleBrush}"/>
                                <TextBox Text="{Binding StartRow, UpdateSourceTrigger=PropertyChanged}" Width="70" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding ShowStartCol, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                                <TextBlock Text="&#x2194; &#x958B;&#x59CB;&#x5217;:" FontSize="11" Foreground="{StaticResource SubtleBrush}"/>
                                <TextBox Text="{Binding StartCol, UpdateSourceTrigger=PropertyChanged}" Width="70" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding ShowLen, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                                <TextBlock Text="&#x1F4CF; &#x9577;&#x3055;:" FontSize="11" Foreground="{StaticResource SubtleBrush}"/>
                                <TextBox Text="{Binding Len, Converter={StaticResource ByteToHex}, UpdateSourceTrigger=PropertyChanged}" Width="70" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding ShowRowLen, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                                <TextBlock Text="&#x2195; &#x884C;&#x6570;:" FontSize="11" Foreground="{StaticResource SubtleBrush}"/>
                                <TextBox Text="{Binding RowLen, UpdateSourceTrigger=PropertyChanged}" Width="70" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding ShowColLen, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                                <TextBlock Text="&#x2194; &#x5217;&#x6570;:" FontSize="11" Foreground="{StaticResource SubtleBrush}"/>
                                <TextBox Text="{Binding ColLen, UpdateSourceTrigger=PropertyChanged}" Width="70" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding ShowFrameNo, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                                <TextBlock Text="&#x1F3AC; &#x30D5;&#x30EC;&#x30FC;&#x30E0;&#x756A;&#x53F7;:" FontSize="11" Foreground="{StaticResource SubtleBrush}"/>
                                <TextBox Text="{Binding FrameNo, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding ShowRxChannel, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                                <TextBlock Text="&#x1F4E1; &#x53D7;&#x4FE1;CH:" FontSize="11" Foreground="{StaticResource SubtleBrush}"/>
                                <TextBox Text="{Binding RxChannel, Converter={StaticResource ByteToHex}, UpdateSourceTrigger=PropertyChanged}" Width="70" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding ShowProgBlock, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                                <TextBlock Text="Prog:" FontSize="11" Foreground="{StaticResource SubtleBrush}"/>
                                <TextBox Text="{Binding ProgNo, Converter={StaticResource ByteToHex}, UpdateSourceTrigger=PropertyChanged}" Width="70" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                <TextBlock Text="Block:" FontSize="11" Foreground="{StaticResource SubtleBrush}"/>
                                <TextBox Text="{Binding BlockNo, Converter={StaticResource ByteToHex}, UpdateSourceTrigger=PropertyChanged}" Width="70" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ゾーン -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="&#x1F4E1; ZONE" Style="{StaticResource SectionHeader}"/>
                            <ComboBox ItemsSource="{Binding ZoneOptions}" SelectedItem="{Binding TargetZoneId}"/>
                        </StackPanel>
                    </Border>

                    <!-- 送信ボタン -->
                    <Button Command="{Binding SendCommand}" Style="{StaticResource ActionButton}"
                            HorizontalAlignment="Stretch" FontSize="15">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F680;" Margin="0,0,8,0" FontSize="16"/>
                            <TextBlock Text="&#x9001;&#x4FE1;"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- ===== エフェクトモード ===== -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEffectMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="&#x2728; EFFECT TYPE" Style="{StaticResource SectionHeader}"/>

                            <!-- エフェクトトグルボタン -->
                            <ItemsControl ItemsSource="{Binding EffectItems}" Margin="0,0,0,10">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton GroupName="EffType"
                                                     IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                     Margin="0,0,4,4" Cursor="Hand">
                                            <RadioButton.Template>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border x:Name="Bd" CornerRadius="4" Padding="12,8"
                                                            BorderThickness="1.5" BorderBrush="#E5E7EB"
                                                            Background="White">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock x:Name="Icon" Text="{Binding Icon}"
                                                                       FontSize="15" VerticalAlignment="Center"
                                                                       Margin="0,0,6,0"/>
                                                            <TextBlock x:Name="Label" Text="{Binding Label}"
                                                                       FontSize="13" FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="#374151"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#4ADE80"/>
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#22C55E"/>
                                                            <Setter TargetName="Label" Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                        <MultiTrigger>
                                                            <MultiTrigger.Conditions>
                                                                <Condition Property="IsChecked" Value="False"/>
                                                                <Condition Property="IsMouseOver" Value="True"/>
                                                            </MultiTrigger.Conditions>
                                                            <Setter TargetName="Bd" Property="Background" Value="#F0FDF4"/>
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#86EFAC"/>
                                                        </MultiTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </RadioButton.Template>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="&#x23F1; SPEED" Style="{StaticResource SectionHeader}"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0"
                                        Minimum="{Binding CycleDurationMin}"
                                        Maximum="{Binding CycleDurationMax}"
                                        Value="{Binding SelectedCycleDuration}"
                                        TickFrequency="100"
                                        IsSnapToTickEnabled="True"
                                        SmallChange="100" LargeChange="1000"
                                        VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding CycleDurationDisplay}"
                                           Width="50" TextAlignment="Right"
                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                           Foreground="{StaticResource SubtleBrush}" FontSize="12" FontWeight="SemiBold"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- エフェクト開始/停止 -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding StartEffectCommand}" Style="{StaticResource ActionButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x25B6;" Margin="0,0,6,0"/>
                                <TextBlock Text="&#x958B;&#x59CB;"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Command="{Binding StopEffectCommand}" Style="{StaticResource DangerButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x25A0;" Margin="0,0,6,0"/>
                                <TextBlock Text="&#x505C;&#x6B62;"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- ステータス -->
                    <TextBlock Text="{Binding EffectStatus}" Foreground="{StaticResource AccentBrush}"
                               FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
