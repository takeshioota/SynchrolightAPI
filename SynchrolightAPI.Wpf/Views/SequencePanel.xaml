<UserControl x:Class="SynchrolightAPI.Wpf.Views.SequencePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SynchrolightAPI.Wpf.Converters">
    <UserControl.Resources>
        <conv:RgbToBrushConverter x:Key="RgbToBrush"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="180"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="400"/>
        </Grid.ColumnDefinitions>

        <!-- ========== 左ペイン: シーケンス一覧 & 再生 ========== -->
        <GroupBox Grid.Column="0" Header="シーケンス一覧">
            <DockPanel Margin="4">
                <!-- 記録コントロール（上部固定） -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <!-- 記録開始ボタン（未記録時のみ表示） -->
                    <Button Content="&#9679; 記録開始" Command="{Binding StartRecordingCommand}"
                            Padding="10,6" FontWeight="Bold" FontSize="13"
                            Background="#E8F5E9" Foreground="#2E7D32"
                            HorizontalAlignment="Stretch" Margin="0,0,0,4">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <!-- 記録中パネル（記録中のみ表示） -->
                    <StackPanel Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}">
                        <Border Background="#FFF3E0" CornerRadius="4" Padding="8,6" Margin="0,0,0,4">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#F44336" Margin="0,2,6,0"/>
                                    <TextBlock Text="記録中" FontWeight="Bold" Foreground="#E65100" FontSize="13"/>
                                </StackPanel>
                                <TextBlock Text="{Binding RecordingInfo}" Foreground="#BF360C"
                                           FontSize="11" Margin="14,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Button Content="&#9632; 記録停止" Command="{Binding StopRecordingCommand}"
                                Padding="10,6" FontWeight="Bold" FontSize="13"
                                Background="#FFEBEE" Foreground="#C62828"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <Separator Margin="0,4,0,0"/>
                </StackPanel>

                <!-- 再生コントロール（下部固定） -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                    <Separator Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Content="&#9654; 再生" Command="{Binding PlaySelectedCommand}"
                                Padding="10,6" FontWeight="Bold" FontSize="13" Background="#DDEEFF" Margin="0,0,4,0"/>
                        <Button Content="&#9632; 停止" Command="{Binding StopCommand}"
                                Padding="10,6" FontSize="13" Foreground="Red"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Content="削除" Command="{Binding DeleteSelectedCommand}"
                                Padding="6,3" Foreground="Red"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Status}" Foreground="DarkGreen" FontSize="11"
                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- 一覧（残り領域） -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Content="更新" Command="{Binding RefreshListCommand}" Padding="6,2"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding SequenceNames}"
                         SelectedItem="{Binding SelectedSequenceName}"
                         FontFamily="Consolas" FontSize="12"/>
            </DockPanel>
        </GroupBox>

        <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Center"
                      VerticalAlignment="Stretch" Background="LightGray"/>

        <!-- ========== 右ペイン: シーケンスエディタ + ログ ========== -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="200"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="150" MinHeight="80"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="シーケンスエディタ">
            <DockPanel Margin="4">

                <!-- 上段: 名前 & 保存 -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="名前:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox Text="{Binding NewSequenceName, UpdateSourceTrigger=PropertyChanged}"
                                 Width="180" Margin="0,0,8,0" FontSize="13"/>
                        <Button Content="保存" Command="{Binding SaveSequenceCommand}"
                                Padding="12,3" FontWeight="Bold" Background="#E8F5E9"/>
                    </StackPanel>

                    <!-- 情報バー -->
                    <TextBlock Text="{Binding EditorInfo}" Foreground="DarkSlateGray" FontSize="11" Margin="0,0,0,4"/>

                    <!-- ツールバー: ステップ操作 -->
                    <WrapPanel Margin="0,0,0,2">
                        <TextBlock Text="操作:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Bold"/>
                        <Button Content="+ 追加" Command="{Binding AddStepCommand}" Padding="6,2" Margin="0,0,2,2"
                                ToolTip="選択行の下に空行を挿入"/>
                        <Button Content="挿入終了" Command="{Binding InsertEndCommand}"
                                Padding="8,2" Margin="0,0,6,2"
                                Background="#FFCDD2" FontWeight="Bold"
                                ToolTip="空行を削除して繰り返し再生"
                                Visibility="{Binding IsInsertMode, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="複製" Command="{Binding DuplicateStepCommand}" Padding="6,2" Margin="0,0,2,2"/>
                        <Button Content="&#9650;" Command="{Binding MoveStepUpCommand}" Padding="6,2" Margin="0,0,2,2" ToolTip="上へ移動"/>
                        <Button Content="&#9660;" Command="{Binding MoveStepDownCommand}" Padding="6,2" Margin="0,0,2,2" ToolTip="下へ移動"/>
                        <Button Content="時刻順ソート" Command="{Binding SortByTimeCommand}" Padding="6,2" Margin="0,0,2,2"/>
                        <Button Content="全クリア" Command="{Binding ClearStepsCommand}" Padding="6,2" Margin="0,0,2,2" Foreground="Red"/>
                    </WrapPanel>

                    <!-- 簡単登録 -->
                    <WrapPanel Margin="0,0,0,2">
                        <TextBlock Text="簡単登録:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Bold"/>
                        <Button Content="色" Command="{Binding AddQuickColorCommand}"
                                Padding="8,2" Margin="0,0,2,2" Background="#C8E6C9" FontWeight="Bold"
                                ToolTip="色（点灯）ステップを追加。■ダブルクリックで色変更"/>
                        <Button Content="OFF" Command="{Binding AddQuickOffCommand}"
                                Padding="8,2" Margin="0,0,2,2" Background="#EEEEEE" FontWeight="Bold"
                                ToolTip="消灯ステップを追加"/>
                        <TextBlock Text="間隔:" VerticalAlignment="Center" Margin="8,0,2,0"/>
                        <TextBox Text="{Binding GapDurationMs, UpdateSourceTrigger=PropertyChanged}"
                                 Width="50" Margin="0,0,2,2" VerticalContentAlignment="Center"/>
                        <TextBlock Text="ms" VerticalAlignment="Center"/>
                    </WrapPanel>

                    <!-- ツールバー: テンプレート -->
                    <WrapPanel Margin="0,0,0,2">
                        <TextBlock Text="テンプレ:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Bold"/>
                        <Button Content="色変更" Command="{Binding AddTemplateColorCommand}"
                                Padding="6,2" Margin="0,0,2,2" Background="#FFECEC" ToolTip="単色ステップを追加"/>
                        <Button Content="呼吸" Command="{Binding AddTemplateFadeInOutCommand}"
                                Padding="6,2" Margin="0,0,2,2" Background="#ECFFEC" ToolTip="Breathing開始+5秒後停止"/>
                        <Button Content="Flash" Command="{Binding AddTemplateFlashCommand}"
                                Padding="6,2" Margin="0,0,2,2" Background="#ECECFF" ToolTip="Flash開始+3秒後停止"/>
                        <Button Content="7色" Command="{Binding AddTemplateSevenColorCommand}"
                                Padding="6,2" Margin="0,0,2,2" Background="#FFFFEC" ToolTip="7色変化+14秒後停止"/>
                        <Button Content="カウントダウン" Command="{Binding AddTemplateCountdownCommand}"
                                Padding="6,2" Margin="0,0,2,2" Background="#FFF0E0" ToolTip="赤→黄→緑→消灯(3秒)"/>
                    </WrapPanel>

                    <!-- ツールバー: エディタ再生 -->
                    <WrapPanel Margin="0,2,0,2">
                        <TextBlock Text="再生:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Bold"/>
                        <Button Content="&#9654; 連続再生" Command="{Binding PlayEditorCommand}"
                                Padding="6,2" Margin="0,0,2,2" Background="#E8F5E9" FontWeight="Bold"
                                ToolTip="エディタ内容を連続再生（ハイライト付き）">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlayingInline}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="&#9654; 繰り返し再生" Command="{Binding PlayEditorLoopCommand}"
                                Padding="6,2" Margin="0,0,2,2" Background="#FFF9C4" FontWeight="Bold"
                                ToolTip="エディタ内容を停止するまで繰り返し再生">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlayingInline}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="&#9632; 停止" Command="{Binding StopEditorCommand}"
                                Padding="6,2" Margin="0,0,2,2" Foreground="Red"
                                Visibility="{Binding IsPlayingInline, Converter={StaticResource BoolToVis}}"
                                ToolTip="エディタ再生を停止"/>
                    </WrapPanel>

                    <Separator Margin="0,2,0,0"/>
                </StackPanel>

                <!-- 下段: DataGrid -->
                <DataGrid x:Name="StepDataGrid"
                          ItemsSource="{Binding EditSteps}"
                          SelectedItem="{Binding SelectedStep}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserSortColumns="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0"
                          FontSize="12"
                          AlternationCount="2"
                          PreviewKeyDown="StepDataGrid_PreviewKeyDown"
                          BeginningEdit="StepDataGrid_BeginningEdit"
                          CellEditEnding="StepDataGrid_CellEditEnding">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <Trigger Property="AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="#FAFAFA"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsPendingInsert}" Value="True">
                                    <Setter Property="Background" Value="#F0F0F0"/>
                                    <Setter Property="FontStyle" Value="Italic"/>
                                    <Setter Property="Foreground" Value="#999999"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                    <Setter Property="Background" Value="#BBDEFB"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <!-- 色プレビュー -->
                        <DataGridTemplateColumn Header="" Width="24" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="16" Height="16" CornerRadius="2"
                                            BorderBrush="Gray" BorderThickness="1"
                                            Cursor="Hand" ToolTip="ダブルクリックで色選択"
                                            MouseLeftButtonDown="ColorPreview_MouseLeftButtonDown">
                                        <Border.Background>
                                            <MultiBinding Converter="{StaticResource RgbToBrush}">
                                                <Binding Path="R"/>
                                                <Binding Path="G"/>
                                                <Binding Path="B"/>
                                            </MultiBinding>
                                        </Border.Background>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 時刻 -->
                        <DataGridTextColumn Header="開始(ms)" Binding="{Binding TimeOffsetMs}" Width="70"/>
                        <DataGridTextColumn Header="(秒)" Binding="{Binding TimeLabel, Mode=OneWay}" Width="45" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="Gray"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- コマンド -->
                        <DataGridComboBoxColumn Header="コマンド" SelectedItemBinding="{Binding CommandType}" Width="85">
                            <DataGridComboBoxColumn.ElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="ItemsSource" Value="{Binding DataContext.CommandTypes, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                </Style>
                            </DataGridComboBoxColumn.ElementStyle>
                            <DataGridComboBoxColumn.EditingElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="ItemsSource" Value="{Binding DataContext.CommandTypes, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                </Style>
                            </DataGridComboBoxColumn.EditingElementStyle>
                        </DataGridComboBoxColumn>

                        <!-- RGB -->
                        <DataGridTextColumn Header="R" Binding="{Binding R}" Width="35"/>
                        <DataGridTextColumn Header="G" Binding="{Binding G}" Width="35"/>
                        <DataGridTextColumn Header="B" Binding="{Binding B}" Width="35"/>

                        <!-- 再送 -->
                        <DataGridTextColumn Header="再送" Binding="{Binding RetransmitCount}" Width="38"/>

                        <!-- エフェクト -->
                        <DataGridComboBoxColumn Header="エフェクト" SelectedItemBinding="{Binding EffectType}" Width="80">
                            <DataGridComboBoxColumn.ElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="ItemsSource" Value="{Binding DataContext.EffectTypes, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                </Style>
                            </DataGridComboBoxColumn.ElementStyle>
                            <DataGridComboBoxColumn.EditingElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="ItemsSource" Value="{Binding DataContext.EffectTypes, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                </Style>
                            </DataGridComboBoxColumn.EditingElementStyle>
                        </DataGridComboBoxColumn>

                        <!-- エフェクト周期 -->
                        <DataGridTextColumn Header="周期(ms)" Binding="{Binding EffectCycleDurationMs}" Width="55"/>

                        <!-- Fadeステップ -->
                        <DataGridTextColumn Header="Fade" Binding="{Binding FadeSteps}" Width="40"/>

                        <!-- 削除ボタン -->
                        <DataGridTemplateColumn Header="" Width="32">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="x"
                                            Command="{Binding DataContext.RemoveStepCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Padding="4,0" Foreground="Red" FontWeight="Bold"
                                            Background="Transparent" BorderThickness="0"
                                            Cursor="Hand" ToolTip="削除"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
            </GroupBox>

            <GridSplitter Grid.Row="1" Height="3" HorizontalAlignment="Stretch"
                          VerticalAlignment="Center" Background="LightGray"/>

            <!-- 送信ログ -->
            <GroupBox Grid.Row="2">
                <GroupBox.Header>
                    <DockPanel LastChildFill="True">
                        <Button Content="クリア" Command="{Binding SendLog.ClearCommand}"
                                DockPanel.Dock="Right" Padding="8,1"/>
                        <TextBlock Text="送信ログ" VerticalAlignment="Center"/>
                    </DockPanel>
                </GroupBox.Header>
                <ListView ItemsSource="{Binding SendLog.Entries}"
                          x:Name="SeqLogListView"
                          FontFamily="Consolas" FontSize="12"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
