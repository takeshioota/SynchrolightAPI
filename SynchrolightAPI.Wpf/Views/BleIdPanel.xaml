<UserControl x:Class="SynchrolightAPI.Wpf.Views.BleIdPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SynchrolightAPI.Wpf.ViewModels"
             d:DataContext="{d:DesignInstance vm:BleIdPanelViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <!-- 上部: 操作ボタン + 書き込みパラメータ -->
        <Grid Grid.Row="0" Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- スキャン・読み取り -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="スキャン" Command="{Binding ScanCommand}" Padding="12,4" Margin="0,0,4,0"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}"/>
                <Button Content="一括読み取り" Command="{Binding ReadAllCommand}" Padding="12,4" Margin="0,0,4,0"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}"/>
                <Button Content="赤色点灯" Command="{Binding LightRedCommand}" Padding="12,4" Margin="0,0,4,0"
                        Background="#FFDDDD" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}"/>
                <Button Content="キャンセル" Padding="12,4" Margin="0,0,8,0"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <Button.Command>
                        <PriorityBinding>
                            <Binding Path="WriteAllCancelCommand"/>
                            <Binding Path="ReadAllCancelCommand"/>
                            <Binding Path="ScanCancelCommand"/>
                        </PriorityBinding>
                    </Button.Command>
                </Button>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="Gray"/>
            </StackPanel>

            <!-- 書き込みパラメータ + 書き込みボタン -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBlock Text="セッション:" VerticalAlignment="Center" Margin="0,0,2,0"/>
                <TextBox Text="{Binding WriteSession}" Width="35" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="開始行:" VerticalAlignment="Center" Margin="0,0,2,0"/>
                <TextBox Text="{Binding WriteStartRow}" Width="45" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="開始列:" VerticalAlignment="Center" Margin="0,0,2,0"/>
                <TextBox Text="{Binding WriteStartCol}" Width="45" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="増分:" VerticalAlignment="Center" Margin="0,0,2,0"/>
                <TextBox Text="{Binding WriteIncrement}" Width="35" Margin="0,0,4,0" VerticalAlignment="Center"/>
                <RadioButton Content="行" IsChecked="{Binding IncrementByRow}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <RadioButton Content="列" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Content="一括書き込み" Command="{Binding WriteAllCommand}" Padding="12,4"
                        Background="#DDDDFF" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}"/>
            </StackPanel>
        </Grid>

        <!-- デバイス一覧 DataGrid -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  CanUserSortColumns="True" GridLinesVisibility="Horizontal"
                  FontFamily="Consolas" FontSize="12" Margin="4,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Width="35"
                    Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow},
                    Converter={StaticResource RowIndexConverter}}"/>
                <DataGridTextColumn Header="アドレス" Width="130" Binding="{Binding AddressHex}"/>
                <DataGridTextColumn Header="名前" Width="90" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="RSSI" Width="55" Binding="{Binding Rssi}"/>
                <DataGridTextColumn Header="セッション" Width="70" Binding="{Binding Session}"/>
                <DataGridTextColumn Header="行" Width="55" Binding="{Binding Row}"/>
                <DataGridTextColumn Header="列" Width="55" Binding="{Binding Col}"/>
                <DataGridTextColumn Header="状態" Width="*" Binding="{Binding Status}"/>
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="2" Height="3" HorizontalAlignment="Stretch" Background="LightGray"/>

        <!-- 操作ログ -->
        <GroupBox Grid.Row="3" Margin="4,0">
            <GroupBox.Header>
                <DockPanel LastChildFill="True">
                    <Button Content="クリア" Command="{Binding ClearLogCommand}" DockPanel.Dock="Right" Padding="8,1"/>
                    <TextBlock Text="操作ログ" VerticalAlignment="Center"/>
                </DockPanel>
            </GroupBox.Header>
            <ListBox ItemsSource="{Binding Log}" FontFamily="Consolas" FontSize="11"
                     x:Name="LogList"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     VirtualizingStackPanel.IsVirtualizing="True"/>
        </GroupBox>
    </Grid>
</UserControl>
