{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "FileLog": {
      "Enabled": true,
      "Directory": "logs",
      "MinLevel": "Information",
      "RetainedDays": 30
    }
  },
  "AllowedHosts": "*",
  "SerialPort": {
    "SendIntervalMs": 5,
    "QueueCapacity": 256
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5100"
      }
    }
  }
}
